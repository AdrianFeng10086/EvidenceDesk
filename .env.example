# 环境变量配置模板

# =============================================================================
# 后端配置
# =============================================================================

# API 服务
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4

# CORS（仅开发环境使用，生产环境需收紧）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# AI 模型配置
# =============================================================================

# 主 LLM，用于推理与工具调用（OpenAI 兼容接口）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com

# 视觉模型，用于视觉证据（必须支持图片输入）
# 未设置时，VISION_API_KEY / VISION_BASE_URL 回退到 LLM_*
VISION_MODEL=deepseek-flash
VISION_API_KEY=your_deepseek_api_key_here
# VISION_BASE_URL=https://api.deepseek.com

# 向量检索使用的嵌入模型（Cloudflare Workers AI）
# 接口地址：https://api.cloudflare.com/client/v4/accounts/{CLOUDFLARE_ACCOUNT_ID}/ai/run/{EMBEDDING_MODEL}
# EMBEDDING_API_KEY 是具备 "Workers AI" 权限的 Cloudflare API Token
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
EMBEDDING_API_KEY=your_cloudflare_api_token_here
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30

# 模型参数
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# =============================================================================
# 数据库配置
# =============================================================================

# SQLite 数据库
DATABASE_URL=sqlite:///./data/db/evidence.db
DATABASE_ECHO=false

# 向量数据库（Chroma）
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_PREFIX=workspace_

# =============================================================================
# 文件存储配置
# =============================================================================

# 上传目录
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# PDF 处理
MAX_PDF_PAGES=30
MAX_PDF_SIZE_MB=10
PDF_DPI=150

# 图像生成（用于视觉证据）
PAGE_IMAGE_FORMAT=png
PAGE_IMAGE_MAX_WIDTH=1600
PAGE_IMAGE_MAX_HEIGHT=2200

# =============================================================================
# 资源限制
# =============================================================================

# 单个资料空间限制
MAX_DOCUMENTS_PER_WORKSPACE=10
MAX_WORKSPACES_PER_USER=5

# 单次请求限制
MAX_RETRIEVAL_RESULTS=20
MAX_TOOL_CALLS_PER_RUN=15
MAX_RUN_DURATION_SECONDS=120

# 并发处理
MAX_CONCURRENT_PARSES=3
MAX_CONCURRENT_RUNS_PER_USER=2

# =============================================================================
# 安全配置
# =============================================================================

# JWT 认证（如启用）
# JWT_SECRET_KEY=your_secret_key_here
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440

# 演示模式（评估时允许免认证访问）
DEMO_MODE=true
DEMO_WORKSPACE_ID=demo_workspace

# API 限流
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# 日志配置
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/evidence-desk.log

# =============================================================================
# 监控与遥测
# =============================================================================

# 启用指标采集
METRICS_ENABLED=true

# 统计 token 用量与费用
COST_TRACKING_ENABLED=true

# OpenTelemetry（可选）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# =============================================================================
# 开发与测试
# =============================================================================

# 运行环境
ENV=development

# 热重载
AUTO_RELOAD=true

# 样例数据
LOAD_SAMPLE_DATA=true
SAMPLE_DATA_DIR=./data/examples

# =============================================================================
# 前端配置（Next.js）
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# =============================================================================
# 注意事项
# =============================================================================

# 1. 将所有占位值（your_*_api_key_here）替换为真实凭据
# 2. 切勿将包含真实凭据的 .env 文件提交到版本控制
# 3. 开发、预发布和生产环境请使用不同的 .env 文件
# 4. 生产环境请设置 ENV=production、DEMO_MODE=false
# 5. 生产环境请将 CORS_ORIGINS 限制为实际前端域名
# 6. 生产环境请使用强 JWT_SECRET_KEY（可用 openssl rand -hex 32 生成）
